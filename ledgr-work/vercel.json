{
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "env": {
    "DATABASE_URL": "@ledgr-database-url",
    "DIRECT_URL": "@ledgr-direct-url",
    "NEXT_PUBLIC_SUPABASE_URL": "@ledgr-supabase-url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@ledgr-supabase-anon-key"
  }
}
